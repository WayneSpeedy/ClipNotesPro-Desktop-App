{
  "name": "clipnotespro-desktop",
  "version": "1.0.12",
  "description": "ClipNotesPro Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WayneSpeedy/ClipNotesPro-Desktop-App.git"
  },
  "build": {
    "appId": "com.clipnotespro.desktop",
    "productName": "ClipNotesPro",
    "artifactName": "${productName}-Setup.${ext}",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "appx": {
      "identityName": "REPLACE_WITH_IDENTITY_NAME",
      "publisher": "CN=REPLACE_WITH_PUBLISHER_ID",
      "publisherDisplayName": "REPLACE_WITH_DISPLAY_NAME",
      "displayName": "ClipNotesPro",
      "backgroundColor": "#FFFFFF",
      "showNameOnTiles": false
    },
    "mac": {
      "target": "dmg",
      "icon": "Image.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "Image.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "WayneSpeedy",
        "repo": "ClipNotesPro-Desktop-App"
      }
    ]
  },
  "dependencies": {
    "electron-log": "^5.4.1",
    "electron-updater": "^6.6.2"
  }
}
